*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local databases & storage
*.db
*.sqlite
*.sqlite3
postgres-data/
redis-data/

# Virtual environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Logs, scratch files & test artifacts
*.log
logs/
scratch/
browser/
downloads/
