# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Opportunity Intelligence & Consultative Sales Platform
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (Windows PowerShell)
# 2. Fill in the values for your environment.
# 3. NEVER commit your actual .env file or credentials to Git or logs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & GENERAL
# ------------------------------------------------------------------------------
# Options: "development", "staging", "production"
# Setting to "production" enables strict validation (requires PostgreSQL, secure keys, Redis).
ENVIRONMENT=development
PROJECT_NAME="Generic AI Business Opportunity Discovery & Sales Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL for Production)
# ------------------------------------------------------------------------------
# Production MUST be PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<dbname>
# SQLite (sqlite:///./opportunity_platform.db) is allowed ONLY for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunity_platform

# ------------------------------------------------------------------------------
# 3. TASK QUEUE & WORKER (Redis / Valkey)
# ------------------------------------------------------------------------------
# Connection string for Redis or Valkey instance (e.g., redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0
# Options: "auto" (uses Redis if reachable, else in-process), "redis" (strict Redis), "sync" (dev only)
QUEUE_MODE=auto

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC KEYS & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Generate 32+ byte random keys via: openssl rand -base64 32

# Master Key Encryption Key (AES-256 KEK) for provider credentials & API keys
# Must be a 32-byte base64 encoded string:
ENCRYPTION_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# JWT Authentication Secret & Session Expiry
JWT_SECRET_KEY=change-me-to-a-secure-random-32-character-secret-key!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cryptographic Suppression HMAC Keys (Key-versioned permanent opt-out hashes)
SUPPRESSION_ACTIVE_KEY_VERSION=1
SUPPRESSION_HMAC_KEY_V1=change-me-to-a-secure-hmac-key-v1-32-chars-min!
# SUPPRESSION_HMAC_KEY_V2=optional-key-v2-for-zero-downtime-key-rotation

# Secure Unsubscribe Token & CSRF Secrets
UNSUBSCRIBE_TOKEN_SECRET=change-me-to-a-secure-unsubscribe-token-secret!
UNSUBSCRIBE_TOKEN_EXPIRE_DAYS=30
CSRF_SECRET_KEY=change-me-to-a-secure-csrf-protection-secret-key!

# Emergency Kill Switch Default (true/false)
GLOBAL_EMERGENCY_KILL_SWITCH=false

# ------------------------------------------------------------------------------
# 5. INBOUND WEBHOOK AUTHENTICATION
# ------------------------------------------------------------------------------
# Shared secret for verifying provider HMAC-SHA256 signatures (X-Webhook-Signature)
INBOUND_WEBHOOK_SECRET=whsec_change_me_to_a_secure_webhook_secret_32b!

# ------------------------------------------------------------------------------
# 6. EMAIL TRANSPORT & PROVIDER INTEGRATION
# ------------------------------------------------------------------------------
# Transport mode: "auto", "smtp", "api"
EMAIL_TRANSPORT_MODE=auto

# --- OPTION A: SMTP Configuration (SendGrid, Mailgun, AWS SES, or custom SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-real-smtp-password-or-api-key
SMTP_USE_TLS=true

# --- OPTION B: Transactional Email API (Resend or Postmark) ---
# Set EMAIL_API_PROVIDER to "resend" or "postmark"
EMAIL_API_PROVIDER=resend
EMAIL_API_KEY=re_your_real_resend_api_key_here

# ------------------------------------------------------------------------------
# 7. LLM PROVIDER CONFIGURATION (Model-Agnostic Production Subsystem)
# ------------------------------------------------------------------------------
# Provider options: "openai", "rule_based", "mock"
# Default provider: "openai" (compatible with OpenAI and OpenAI-compatible gateways)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Bounded Retries & Timeouts
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# Cost & Token Guardrails
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_COST_PER_RUN=0.50
LLM_DAILY_COST_LIMIT=10.00

# ------------------------------------------------------------------------------
# 8. FRONTEND & CORS SETTINGS
# ------------------------------------------------------------------------------
# Origins allowed to make cross-origin API calls to the backend
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:8000"]
